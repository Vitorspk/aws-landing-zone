# ==============================================================================
# TERRAFORM
# ==============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
*.tfvars.json
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ==============================================================================
# CREDENTIALS & SECRETS
# ==============================================================================
*.pem
*.key
*.p12
*.pfx
.aws/
*-policy.json
!docs/*-policy.json
.env
.env.local
.env.*
!.env.example

# ==============================================================================
# OPERATING SYSTEM
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ==============================================================================
# IDE & EDITORS
# ==============================================================================
# VSCode
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*.swn
.*.sw[a-p]

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# Sublime Text
*.sublime-project
*.sublime-workspace

# Claude Code
.claude/

# Superpowers SDD scratch workspace (ledgers, task briefs/reports, review
# packages) -- not project content. docs/superpowers/specs/ is separate and
# intentionally tracked (design specs and plans).
/.superpowers/

# ==============================================================================
# LOGS & TEMPORARY FILES
# ==============================================================================
*.log
*.tmp
*.temp
*.bak
*.cache

# ==============================================================================
# AWS SPECIFIC
# ==============================================================================
# AWS Credentials (NEVER commit these!)
credentials
config
.aws/

# Terraform Backend Config
backend-config.hcl

# SSH Keys
*.pem
id_rsa*
id_ecdsa*
id_ed25519*

# ==============================================================================
# SCRIPTS BACKUP
# ==============================================================================
*.sh.bak
*.backup

# ==============================================================================
# KUBERNETES
# ==============================================================================
kubeconfig
*.kubeconfig
.kube/

# ==============================================================================
# CI/CD
# ==============================================================================
.github/workflows/secrets/

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# This .gitignore is designed to prevent accidental commits of:
# 1. Terraform state files (use remote backend instead)
# 2. Variable files with real values (use .tfvars.example as template)
# 3. AWS credentials and keys
# 4. Environment-specific configuration
# 5. IDE and OS-specific files
#
# Always review files before committing with: git status
# ==============================================================================
