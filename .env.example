# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env and fill with your actual values
# DO NOT commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env  # Load variables into your shell
# ==============================================================================

# AWS Configuration
export AWS_DEFAULT_REGION="sa-east-1"
export AWS_PROFILE="default"

# Terraform State Backend
export TF_STATE_BUCKET="your-terraform-state-bucket"
export TF_STATE_DYNAMODB_TABLE="terraform-state-lock"

# Terraform Variables
export TF_VAR_region="${AWS_DEFAULT_REGION}"
export TF_VAR_deploy_clusters="dev"  # or "dev,stg" or "all"

# GitHub Actions (for CI/CD)
# Note: These should be set as GitHub Secrets, not in local .env
# export AWS_ACCESS_KEY_ID="your-access-key-id"
# export AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# ==============================================================================
# SECURITY WARNING
# ==============================================================================
# NEVER commit .env file with real values!
# This file is in .gitignore for your protection
# Always use GitHub Secrets for CI/CD pipelines
# ==============================================================================
