# ==============================================================================
# AWS REGION CONFIGURATION
# ==============================================================================

region = "sa-east-1"

# ==============================================================================
# CLUSTER SELECTION
# ==============================================================================
# Comma-separated list of clusters to deploy, or "all" for every cluster.

deploy_clusters = "all"

# Examples:
# - Deploy only dev: deploy_clusters = "dev"
# - Deploy dev + stg: deploy_clusters = "dev,stg"
# - Deploy all: deploy_clusters = "all"
